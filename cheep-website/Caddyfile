# İç servis — TLS yok (edge Caddy hallediyor).
#
# Build, her rotayı prerender edip `dist/<yol>/index.html` olarak yazıyor
# (scripts/prerender.mjs). Sıralama önemli:
#   {path}            → gerçek dosya (asset, font, robots.txt, sitemap.xml)
#   {path}/index.html → prerender edilmiş sayfa (/pl → /pl/index.html)
#   (eşleşme yoksa)   → gerçek HTTP 404 + dist/404.html
#
# SPA fallback (/index.html) BİLEREK KALDIRILDI. Her geçerli URL prerender
# edildiği için geri dönüşe gerek yok; varken bilinmeyen yollara anasayfa
# HTML'ini 200 ile sunuyordu. Bu hem Google için "soft 404" (silinmiş ürün
# sayfaları indekste kalıyordu) hem de istemci farklı bir sayfa çizdiği için
# React hydration uyuşmazlığı (#418) üretiyordu.
:80 {
	root * /srv
	encode gzip zstd

	# Taksonomi birleştirmesinde silinen kategori slug'ları için 301'ler.
	# Build üretiyor (scripts/prerender.mjs) ve boş olsa da HER ZAMAN yazıyor —
	# eksik import dosyası Caddy'yi başlatmaz.
	import /srv/redirects.caddy

	try_files {path} {path}/index.html
	file_server

	handle_errors {
		# DİLE GÖRE 404. Tek bir Türkçe sayfa sunuluyordu; Lehçe bir yoldan
		# gelen ziyaretçi baştan sona Türkçe bir hata sayfası ve TÜRKÇE
		# anasayfaya giden tek bir düğme görüyordu. Prerender artık
		# `dist/pl/404.html`i de üretiyor.
		#
		# HER İKİ DAL DA `handle` OLMAK ZORUNDA. Türkçe dal önce çıplak
		# `rewrite * /404.html` + `file_server` şeklinde yazılmıştı ve Lehçe
		# dal HİÇ ÇALIŞMADI: Caddy direktifleri yazıldıkları sırayla değil
		# KENDİ sabit öncelik sırasıyla işletiyor ve `rewrite`, `handle`dan
		# ÖNCE geliyor. Yani koşulsuz rewrite her istekte önce koşuyor, yolu
		# `/404.html` yapıyor ve ondan sonra bakılan `@pl path /pl/*`
		# matcher'ı artık eşleşmiyordu. Üretimde `/pl/yokboyle` bu yüzden
		# `<html lang="tr">` dönüyordu — dosya ve matcher doğruydu, sıra değil.
		# `handle` blokları birbirini dışlar ve yazım sırasına uyar.
		@pl path /pl /pl/*
		handle @pl {
			rewrite * /pl/404.html
			file_server
		}
		handle {
			rewrite * /404.html
			file_server
		}
	}

	# İçerik hash'li asset'ler — adları değişmeden içerikleri değişemez.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Fontlar hash'siz (adları aile+ağırlık+alt küme kodluyor). Uzun ömürlü ama
	# `immutable` değil: bir gün dosya değişirse tarayıcı yine de doğrulayabilsin.
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000"

	@images path *.png *.jpg *.webp *.svg *.ico
	header @images Cache-Control "public, max-age=604800"

	@crawl path /robots.txt /sitemap.xml
	header @crawl Cache-Control "public, max-age=3600"

	# Geri kalan her şey HTML. `*.html` ile eşleştirmek yetmiyor: prerender
	# edilmiş sayfalara /pl, /terms gibi uzantısız yollarla geliniyor.
	@html not path /assets/* /fonts/* *.png *.jpg *.webp *.svg *.ico /robots.txt /sitemap.xml
	header @html Cache-Control "public, max-age=0, must-revalidate"
}
