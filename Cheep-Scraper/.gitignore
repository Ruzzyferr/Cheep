# DIKKAT — bu desen KOK DIZINDEKI uretilen dosya icindir (marketfiyati akisi
# yaziyor). Dosya ADINA gore yazildigi icin ELLE TUTULAN ulke haritalarini da
# (countries/<ulke>/category_map.json) yutuyordu: PL/DE/SE/CH dosyalari ancak
# `git add -f` ile girebilmis, yeni eklenen HR/HU/RO ise SESSIZCE disarida
# kalmisti. O hâliyle deploy edilseydi uc ulkenin TUM urunleri kategorisiz
# kaydedilir, hicbir listede ve hicbir kategori sayfasinda gorunmezdi.
# Cozum: deseni koke sabitle + ulke haritalarini acikca haric tut.
/category_map.json
!countries/*/category_map.json
countries/*/off_cache.sqlite
*.tgz
shots/

# off_bulk.py: downloaded Open Food Facts full-dataset dump + the local
# SQLite EAN index built from it. Both are large, reproducible (re-derived
# from a public OFF URL / from the dump by build_pl_index) and NOT code —
# never committed. (*.sqlite/*.sqlite3 already covered by the repo root
# .gitignore; listed here too so intent is explicit next to off_cache.)
countries/*/off_bulk_data/
countries/*/off_bulk_index.sqlite
