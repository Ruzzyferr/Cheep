# Cheep TÜRKİYE haftalık katalog yenileme — PAZAR günü, gün boyu.
# 03:00 sunucu saati Pazar; fetch WAF rate-limit yüzünden gün içine yayılır.
# Kur: crontab -l | grep -v run_weekly.sh | cat - scheduler/cheep-scrape.cron | crontab -
0 3 * * 0 CHEEP_SCRAPER_DIR=/opt/cheep/Cheep-Scraper CHEEP_API_URL=http://localhost:3000/api/v1 /opt/cheep/Cheep-Scraper/scheduler/run_weekly.sh
