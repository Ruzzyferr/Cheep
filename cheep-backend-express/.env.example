# ============================================
# Cheep Backend — Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun. `.env` ASLA commit edilmez.
# ============================================

# --- Sunucu ---
PORT=3000
NODE_ENV=development

# --- Veritabanı (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cheep?schema=public"

# --- Kimlik Doğrulama ---
# Production'da ZORUNLU ve en az 32 karakter olmalı. Güçlü rastgele bir değer kullanın.
JWT_SECRET="en-az-32-karakterlik-cok-gizli-rastgele-bir-deger"
# Refresh token'lar için AYRI secret (access secret'ından farklı, min 32 karakter).
# Production'da ZORUNLU; JWT_SECRET ile aynı olamaz.
JWT_REFRESH_SECRET="en-az-32-karakterlik-FARKLI-cok-gizli-refresh-degeri"

# --- CORS ---
# Virgülle ayrılmış izin verilen origin listesi. Boş bırakılırsa dev'de origin yansıtılır.
ALLOWED_ORIGINS="http://localhost:8081,https://app.cheep.com"

# --- Ingestion (scraper -> backend yazma endpoint'leri) ---
# Production'da ZORUNLU. Scraper bu anahtarı `x-api-key` header'ında gönderir.
INGEST_API_KEY="scraper-icin-paylasilan-gizli-anahtar"

# --- LLM (ürün eşleştirme / import) ---
# OpenAI veya OpenRouter'dan birini yapılandırın.
USE_OPENROUTER=false
OPENAI_API_KEY="sk-..."
OPENROUTER_API_KEY="sk-or-..."
# Genel LLM ayarları (opsiyonel)
LLM_API_KEY=""
LLM_API_URL=""
LLM_MODEL="gpt-4o-mini"
OPENROUTER_HTTP_REFERER="https://cheep.app"
OPENROUTER_X_TITLE="Cheep"

# --- AI Asistan (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- E-posta (SMTP — kayıt doğrulama kodu) ---
# Gmail / Google Workspace: host smtp.gmail.com, port 465 (secure).
# SMTP_PASSWORD bir "uygulama şifresi"dir (normal parola değil). Boşluklu girilebilir; kod boşlukları temizler.
# Boş bırakılırsa e-posta gönderimi devre dışı kalır (kayıt yine çalışır, kod log'a yazılır).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@swiip.app
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=info@swiip.app
SMTP_FROM_NAME=Cheep
