# ============================================
# Cheep Backend — Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun. `.env` ASLA commit edilmez.
# ============================================

# --- Sunucu ---
PORT=3000
NODE_ENV=development

# --- Veritabanı (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cheep?schema=public"

# --- Kimlik Doğrulama ---
# Production'da ZORUNLU ve en az 32 karakter olmalı. Güçlü rastgele bir değer kullanın.
JWT_SECRET="en-az-32-karakterlik-cok-gizli-rastgele-bir-deger"
# Refresh token'lar için AYRI secret (access secret'ından farklı, min 32 karakter).
# Production'da ZORUNLU; JWT_SECRET ile aynı olamaz.
JWT_REFRESH_SECRET="en-az-32-karakterlik-FARKLI-cok-gizli-refresh-degeri"

# --- CORS ---
# Virgülle ayrılmış izin verilen origin listesi. Boş bırakılırsa dev'de origin yansıtılır.
ALLOWED_ORIGINS="http://localhost:8081,https://app.cheep.com"

# --- Ingestion (scraper -> backend yazma endpoint'leri) ---
# Production'da ZORUNLU. Scraper bu anahtarı `x-api-key` header'ında gönderir.
INGEST_API_KEY="scraper-icin-paylasilan-gizli-anahtar"

# --- LLM (ürün eşleştirme / import) ---
# OpenAI veya OpenRouter'dan birini yapılandırın.
USE_OPENROUTER=false
OPENAI_API_KEY="sk-..."
OPENROUTER_API_KEY="sk-or-..."
# Genel LLM ayarları (opsiyonel)
LLM_API_KEY=""
LLM_API_URL=""
LLM_MODEL="gpt-4o-mini"
OPENROUTER_HTTP_REFERER="https://cheep.app"
OPENROUTER_X_TITLE="Cheep"

# --- AI Asistan (Vercel AI Gateway) ---
# Anahtar: vercel.com/<takim>/~/ai-gateway/api-keys  (harcama siniri anahtar bazli)
AI_GATEWAY_API_KEY=
# Model slug'i: <saglayici>/<model>. Bos birakilirsa google/gemini-3.1-flash-lite.
AI_MODEL=google/gemini-3.1-flash-lite

# --- Abonelik (RevenueCat / Cheep Premium) ---
# webhook sirri: RevenueCat panelinde webhook'a yazdigin Authorization degeri.
#   Bos birakilirsa webhook ucu 503 doner (acik kalmaz) ve premium haklari guncellenmez.
REVENUECAT_WEBHOOK_SECRET=
# v1 secret anahtar (sk_...). Webhook kacarsa durumu tazelemek icin kullanilir.
REVENUECAT_API_KEY=

# --- E-posta (kayıt doğrulama kodu) ---
# TERCİH: Resend HTTP API (443 portu) — bulut sunucularında SMTP bloklansa bile çalışır.
# RESEND_API_KEY verilirse Resend kullanılır; yoksa aşağıdaki SMTP'ye düşülür.
RESEND_API_KEY=
# Gönderen adresi (Resend'de doğrulanmış domain/sender olmalı). Boşsa SMTP_FROM_EMAIL kullanılır.
EMAIL_FROM=info@swiip.app

# --- E-posta (SMTP — alternatif/yerel) ---
# Gmail / Google Workspace: host smtp.gmail.com, port 465 (secure).
# SMTP_PASSWORD bir "uygulama şifresi"dir (normal parola değil). Boşluklu girilebilir; kod boşlukları temizler.
# Boş bırakılırsa e-posta gönderimi devre dışı kalır (kayıt yine çalışır, kod log'a yazılır).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@swiip.app
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=info@swiip.app
SMTP_FROM_NAME=Cheep

# --- Push bildirimleri: Android (FCM) ---
# Firebase servis hesabı JSON'unun tamamı (tek satır) veya base64'ü.
# google-services.json'dan FARKLI: bu gerçek bir sırdır, uygulamaya gömülmez.
FCM_SERVICE_ACCOUNT=
FCM_PROJECT_ID=

# --- Push bildirimleri: iOS (APNs) ---
# iOS token'ları FCM'e gönderilemez: uygulama ham APNs cihaz token'ı alıyor,
# FCM ise kendi kayıt token'ını bekliyor. Bu yüzden iOS doğrudan APNs'e gider.
# APNS_KEY: App Store Connect > Users and Access > Integrations'tan indirilen
# .p8 anahtarının içeriği. Ya base64'ü (önerilir) ya da satır sonları kaçışlı
# tek satır hâli. Yedeği: ~/CheepKeys/apple/AuthKey_2K3JUBFW75.p8
APNS_KEY=
APNS_KEY_ID=2K3JUBFW75
APNS_TEAM_ID=3HPYDLAP64
APNS_BUNDLE_ID=com.cheep.mobile
# Varsayılan production. TestFlight/geliştirme derlemeleri için:
# APNS_HOST=api.sandbox.push.apple.com
APNS_HOST=api.push.apple.com
