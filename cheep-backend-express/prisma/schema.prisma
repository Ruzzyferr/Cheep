// Cheep - Akıllı Alışveriş Asistanı
// Prisma Schema Dosyası

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// KULLANICI YÖNETİMİ
// ============================================

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  name          String
  country_id    Int? // Tercih edilen ülke (konumdan veya seçimden)
  language      String? // Tercih edilen arayüz dili (ISO-639-1: "tr","en","de","pl","sv") — ülkeden bağımsız
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  is_premium    Boolean  @default(false)
  token_version Int      @default(0) // refresh token iptali: logout/parola değişiminde +1

  // E-posta doğrulama (kayıt sonrası 6 haneli kod)
  email_verified             Boolean   @default(false)
  email_verification_code    String? // bcrypt hash'lenmiş 6 haneli kod
  email_verification_expires DateTime? // kodun son geçerlilik anı

  // İlişkiler
  country          Country?            @relation(fields: [country_id], references: [id], onDelete: SetNull)
  lists            List[]
  favorite_stores  UserFavoriteStore[]
  price_feedbacks  PriceFeedback[]
  profile          UserProfile?
  chat_threads     ChatThread[]
  affiliate_clicks AffiliateClick[]
  support_messages SupportMessage[]
  price_drops      PriceDrop[]
  push_tokens      UserPushToken[]

  @@map("users")
}

// ============================================
// ÜLKE (çok-ülke / konum bazlı)
// ============================================

model Country {
  id       Int    @id @default(autoincrement())
  code     String @unique // ISO 3166-1 alpha-2: "TR", "PL"
  name     String // "Türkiye", "Polska"
  currency String // "TRY", "PLN"

  created_at DateTime @default(now())

  // İlişkiler
  stores     Store[]
  products   Product[]
  users      User[]
  branches   StoreBranch[]
  lists      List[]
  categories Category[]

  category_redirects CategoryRedirect[]

  price_drops PriceDrop[]

  @@map("countries")
}

// ============================================
// MARKET VE KONUM
// ============================================

model Store {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String? // SEO sayfası URL'i — bir kez üretilir, ASLA değişmez
  logo_url    String?
  address     String?
  city        String?
  lat         Float? // Enlem (Latitude)
  lon         Float? // Boylam (Longitude)
  country_id  Int
  website_url String? // Online market / sepet tamamlama bağlantısı (affiliate temeli)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // İlişkiler
  country           Country             @relation(fields: [country_id], references: [id], onDelete: Cascade)
  store_prices      StorePrice[]
  favorite_by_users UserFavoriteStore[]
  price_history     PriceHistory[]
  affiliate_clicks  AffiliateClick[]
  branches          StoreBranch[]
  price_drops       PriceDrop[]

  @@unique([country_id, slug])
  @@index([country_id])
  @@map("stores")
}

model StoreBranch {
  id           Int      @id @default(autoincrement())
  store_id     Int
  country_id   Int
  name         String
  lat          Float
  lon          Float
  address      String?
  city         String?
  source       String // 'osm' | 'locator'
  external_ref String   @unique // 'osm:node/123', 'locator:migros:4567'
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  store   Store   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  country Country @relation(fields: [country_id], references: [id], onDelete: Cascade)

  @@index([country_id])
  @@index([store_id])
  @@index([lat, lon])
  @@map("store_branches")
}

// ============================================
// AFFILIATE TIKLAMA TAKİBİ
// ============================================
// Kullanıcı "Sepeti markette tamamla" / "Markete git" dediğinde kaydedilir.
// URL üretimi sunucu tarafında olduğu için ileride gerçek affiliate linkine
// geçince mobil güncelleme gerekmez.
model AffiliateClick {
  id         Int      @id @default(autoincrement())
  user_id    Int
  store_id   Int
  list_id    Int? // sepet bağlamı (varsa)
  product_id Int? // tek ürün bağlamı (varsa)
  context    String   @default("store") // 'cart' | 'product' | 'store'
  created_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([store_id])
  @@index([created_at])
  @@map("affiliate_clicks")
}

model UserFavoriteStore {
  user_id  Int
  store_id Int

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@id([user_id, store_id])
  @@map("user_favorite_stores")
}

// ============================================
// ÜRÜN KATEGORİLERİ (HİYERARŞİK)
// ============================================

// Taksonomi ÜLKEYE BAĞLI. Uzun süre değildi ve `slug` global @unique idi;
// TR (devletin marketfiyati verisinden türetilen ağaç) ile PL (scraper'ın kendi
// ağacı) tek ağaca sıkışınca ikiz kategoriler ("Atıştırmalık" vs "Atıştırmalık
// ve Tatlı") ve ölü kabuklar ("Meyve ve Sebze": 0 ürün, 0 çocuk) üredi.
// Benzersizlik ülke başına olunca iki taksonomi çakışmadan yan yana durur ve
// her ülke kendi kaynağından türetilebilir.
model Category {
  id            Int     @id @default(autoincrement())
  name          String
  slug          String
  country_id    Int
  parent_id     Int? // NULL ise ana kategori, değilse alt kategori
  display_order Int     @default(0) // Sıralama için
  icon_url      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Self-referencing ilişki
  parent   Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  // İlişkiler
  country  Country   @relation(fields: [country_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([country_id, slug])
  @@index([parent_id])
  @@index([country_id, parent_id])
  @@map("categories")
}

/// Birleştirme sırasında silinen kategorilerin eski slug'ları. Site üretimi
/// buradan 301 kuralları türetir; yayındaki kategori URL'leri kırılmasın.
model CategoryRedirect {
  id         Int      @id @default(autoincrement())
  country_id Int
  old_slug   String
  new_slug   String
  created_at DateTime @default(now())

  country Country @relation(fields: [country_id], references: [id], onDelete: Cascade)

  @@unique([country_id, old_slug])
  @@map("category_redirects")
}

// ============================================
// ÜRÜNLER VE FİYATLAR
// ============================================

model Product {
  id             Int     @id @default(autoincrement())
  name           String
  slug           String? // SEO sayfası URL'i — bir kez üretilir, ASLA değişmez
  brand          String?
  ean_barcode    String? // EAN/UPC barkod numarası (benzersizlik ülke-scope: @@unique aşağıda)
  image_url      String?
  category_id    Int?
  muadil_grup_id String? // Muadil ürünleri gruplamak için
  country_id     Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // İlişkiler
  country       Country        @relation(fields: [country_id], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  store_prices  StorePrice[]
  list_items    ListItem[]
  price_history PriceHistory[]
  price_drops   PriceDrop[]

  @@unique([country_id, ean_barcode])
  @@unique([country_id, slug])
  @@index([country_id])
  @@index([muadil_grup_id])
  @@index([category_id])
  @@index([slug])
  @@map("products")
}

model StorePrice {
  id               Int      @id @default(autoincrement())
  store_id         Int
  product_id       Int
  //Markete özgü SKU (örn: Migros'un kendi ürün kodu)
  store_sku        String?
  price            Decimal  @db.Decimal(10, 2) // 10 basamak, 2 ondalık
  unit             String   @default("adet") // kg, adet, lt, g, ml vb.
  raw_name         String? // Zincirin orijinal ürün adı (audit: birleşme doğrulama)
  last_updated_at  DateTime @default(now())
  source           String   @default("scrape") // scrape, api, user
  confidence_score Float    @default(1.0) // 0-1 arası güven skoru

  // İlişkiler
  store           Store           @relation(fields: [store_id], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  price_feedbacks PriceFeedback[]

  @@unique([store_id, product_id]) // Her market-ürün çifti için tek kayıt
  @@unique([store_id, store_sku])
  @@index([product_id])
  @@index([store_id])
  @@index([last_updated_at])
  @@map("store_prices")
}

// ============================================
// ALIŞVERİŞ LİSTELERİ
// ============================================

model List {
  id          Int      @id @default(autoincrement())
  user_id     Int
  // Liste OLUŞTURULDUĞU ülkeye aittir ve yalnızca o ülkedeyken görünür: içindeki
  // ürünler/fiyatlar o ülkenin kataloğuna ait, başka ülkede anlamsız. Aktif liste
  // de ÜLKE BAŞINA tektir (bkz. lists.service createList/activateList).
  country_id  Int
  name        String
  is_template Boolean  @default(false) // Şablon liste mi?
  budget      Decimal? @db.Decimal(10, 2) // Opsiyonel bütçe

  // Geçmiş liste yönetimi
  status           String    @default("active") // active, completed
  completed_at     DateTime? // Liste tamamlanma zamanı
  last_compared_at DateTime? // Son compare zamanı

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // İlişkiler
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  country    Country    @relation(fields: [country_id], references: [id], onDelete: Cascade)
  list_items ListItem[]

  @@index([user_id])
  @@index([country_id])
  @@index([is_template])
  @@index([status])
  @@map("lists")
}

model ListItem {
  id                Int     @id @default(autoincrement())
  list_id           Int
  product_id        Int
  quantity          Float   @default(1) // Miktar (1.5 kg, 2 adet vb.)
  unit              String  @default("adet") // kg, adet, lt, g, ml vb.
  brand_independent Boolean @default(false) // true → muadil grubundaki en ucuz markayı seç

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // İlişkiler
  list    List    @relation(fields: [list_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([list_id, product_id]) // Aynı listede aynı ürün sadece bir kez
  @@index([list_id])
  @@index([product_id])
  @@map("list_items")
}

// ============================================
// KULLANICI GERİ BİLDİRİMLERİ
// ============================================

// ============================================
// FİYAT GEÇMİŞİ (zaman serisi)
// ============================================

model PriceHistory {
  id          Int      @id @default(autoincrement())
  store_id    Int
  product_id  Int
  price       Decimal  @db.Decimal(10, 2)
  recorded_at DateTime @default(now())

  store   Store   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, recorded_at])
  @@index([store_id, product_id])
  @@map("price_history")
}

model PriceFeedback {
  id              Int      @id @default(autoincrement())
  user_id         Int
  store_price_id  Int
  is_accurate     Boolean // Fiyat doğru mu? (true = doğru, false = yanlış)
  suggested_price Decimal? @db.Decimal(10, 2) // Kullanıcının önerdiği fiyat (opsiyonel)
  comment         String? // Opsiyonel kullanıcı yorumu

  created_at DateTime @default(now())

  // İlişkiler
  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  store_price StorePrice @relation(fields: [store_price_id], references: [id], onDelete: Cascade)

  @@unique([user_id, store_price_id]) // Aynı kullanıcı bir fiyata yalnızca bir feedback verir
  @@index([user_id])
  @@index([store_price_id])
  @@index([created_at])
  @@map("price_feedbacks")
}

// ============================================
// SOHBET (AI ASİSTAN)
// ============================================

model ChatThread {
  id         Int           @id @default(autoincrement())
  user_id    Int
  title      String?
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@index([user_id])
  @@map("chat_threads")
}

model ChatMessage {
  id         Int        @id @default(autoincrement())
  thread_id  Int
  role       String // 'user' | 'model' | 'tool'
  content    String     @db.Text
  tool_calls Json?
  created_at DateTime   @default(now())
  thread     ChatThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  @@index([thread_id])
  @@map("chat_messages")
}

// ============================================
// KULLANICI PROFİLİ (onboarding)
// ============================================

model UserProfile {
  id              Int      @id @default(autoincrement())
  user_id         Int      @unique
  household_size  String? // '1' | '2' | '3-4' | '5+'
  diet            String? // 'omnivore' | 'vegetarian' | 'vegan' | 'pescatarian'
  avoid           Json? // ['pork_gelatin','alcohol', ...]
  allergies       Json? // ['lactose','gluten','peanut','tree_nut', ...serbest]
  weekly_budget   Decimal? @db.Decimal(10, 2)
  onboarding_done Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ============================================
// EŞLEŞTİRME TEKLİF KUYRUĞU (sıfır-hata ülkeleri)
// ============================================
// Strict ülkelerde (PL) fuzzy/LLM eşleşmeleri OTOMATİK BİRLEŞMEZ; buraya
// teklif olarak düşer. CLI (scripts/match-review.ts) onaylarsa mergeProducts
// çalışır. product_id = yeni (birleşmemiş) ürün, candidate_product_id = aday.
model MatchProposal {
  id                   Int      @id @default(autoincrement())
  country_id           Int
  product_id           Int
  candidate_product_id Int
  similarity           Float
  evidence             String // 'fuzzy' | 'llm'
  status               String   @default("pending") // pending | approved | rejected
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@unique([product_id, candidate_product_id])
  @@index([status])
  @@index([country_id])
  @@map("match_proposals")
}

// ============================================
// DESTEK MESAJLARI (uygulama içi iletişim formu)
// ============================================
// Mesaj ÖNCE buraya yazılır, SONRA e-postalanır: Resend'in geçici bir arızası
// yüzünden kullanıcının hata raporunu kaybetmek kabul edilemez. `emailed_at`
// null kalan satırlar gönderilememiş demektir.
model SupportMessage {
  id           Int       @id @default(autoincrement())
  user_id      Int? // giriş yapmamış kullanıcı da yazabilir
  email        String // cevap adresi (girişliyse hesabınkiyle aynı olmayabilir)
  topic        String    @default("other") // bug | suggestion | price | account | other
  message      String
  // İstemciden gelen bağlam: "hangi sürümde oldu" diye sormaya gerek kalmasın.
  app_version  String?
  platform     String?
  os_version   String?
  locale       String?
  country_code String?
  emailed_at   DateTime?
  created_at   DateTime  @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([user_id])
  @@map("support_messages")
}

// ============================================
// FİYAT DÜŞÜŞÜ BİLDİRİMLERİ
// ============================================
// Kullanıcının AKTİF listelerindeki ürünler için, o ülkedeki EN DÜŞÜK fiyat
// düştüğünde üretilir. Mağaza başına değil ürün başına: kullanıcıyı ilgilendiren
// sinyal "bu ürün ucuzladı", "şu markette ucuzladı" değil.
//
// Push izninden BAĞIMSIZ oluşur — uygulama içi zil/liste her hâlükârda çalışır.
model PriceDrop {
  id         Int       @id @default(autoincrement())
  user_id    Int
  product_id Int
  country_id Int
  store_id   Int // yeni en ucuz fiyatın olduğu market
  old_price  Decimal   @db.Decimal(10, 2)
  new_price  Decimal   @db.Decimal(10, 2)
  drop_pct   Float
  read_at    DateTime?
  // Tekillik için ayrı GÜN alanı: created_at tam zaman damgası olduğundan
  // (user, product, created_at) kısıtı aynı gün içinde tekrarı engellemezdi.
  dropped_on DateTime  @db.Date
  created_at DateTime  @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  country Country @relation(fields: [country_id], references: [id], onDelete: Cascade)

  // Aynı ürün için günde tek kayıt (tespit işi tekrar koşarsa çoğaltmasın).
  @@unique([user_id, product_id, dropped_on])
  @@index([user_id, read_at])
  @@index([created_at])
  @@map("price_drops")
}

// Cihaz push token'ları. Bir kullanıcının birden fazla cihazı olabilir.
model UserPushToken {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique // Expo push token
  platform   String   @default("android")
  locale     String? // bildirim metnini seçmek için
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_push_tokens")
}
