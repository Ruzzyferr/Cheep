version: 2

# Dependabot GÜVENLİK güncellemeleri repo ayarlarından zaten açık; bu dosya
# rutin SÜRÜM güncellemelerini ekliyor. İkisi farklı: güvenlik güncellemesi
# yalnızca bir açık duyurulduğunda gelir, sürüm güncellemesi bağımlılıklar
# yaşlanmasın diye düzenli gelir.
#
# TASARIM KARARI — az ve gruplu PR. Beş ekosistemde haftalık, paket başına
# ayrı PR açılsaydı haftada onlarca PR olurdu; iki hafta içinde hepsi
# okunmadan kapatılır ve Dependabot güvenilirliğini kaybederdi. O yüzden:
# aylık, gruplanmış, ve ana sürüm atlamaları HARİÇ. Ana sürümler
# (React Native, Expo SDK, Prisma) kırılma riski taşıyor ve bilinçli bir
# göç işi olarak ele alınmalı — otomatik PR'la değil.
updates:
  - package-ecosystem: npm
    directory: /Cheep-Mobile
    schedule: { interval: monthly }
    open-pull-requests-limit: 3
    groups:
      mobil-kucuk-guncellemeler:
        patterns: ['*']
        update-types: [minor, patch]
    ignore:
      - dependency-name: '*'
        update-types: [version-update:semver-major]

      # ── EXPO SDK'NIN SAHİPLENDİĞİ PAKETLER — TAMAMEN HARİÇ ──────────────
      #
      # Yukarıdaki "ana sürüm hariç" kuralı bunları KORUMUYOR. React Native
      # `0.x` şemasında yayınlanıyor ve semver'de `0.81 → 0.87` bir MINOR
      # atlaması sayılıyor — oysa RN'de her minor kırıcı bir sürümdür.
      # `react-native-worklets` (0.5 → 0.12) aynı tuzakta.
      #
      # 26 Ağu 2026'da bu tam olarak gerçekleşti: "küçük güncellemeler"
      # başlıklı bir PR react-native'i 0.81.5'ten 0.87.0'a çıkardı. Expo
      # SDK 54 `bundledNativeModules.json` içinde RN'i 0.81.5'e PİNLİYOR;
      # bu paketlerin sürümü SDK'ya aittir, bağımsız yükseltilemez
      # (autolinking, prebuild şablonları ve yerel modül ABI'si SDK ile
      # birlikte gelir). CI tip hatalarıyla düştü, ama asıl kırılma derleme
      # zamanında ve sessizce olurdu.
      #
      # Güncelleme yolu: `npx expo install --fix` + SDK yükseltmesi, ayrı ve
      # bilinçli bir göç işi olarak. `npx expo-doctor` CI'da bunu bekliyor.
      #
      # LİSTE ELLE TUTULUYOR ama kaynağı yetkili: `expo/bundledNativeModules.json`
      # ile projedeki bağımlılıkların kesişimi. `react-native-*` joker'i
      # BİLEREK kullanılmadı — `react-native-purchases` (RevenueCat) Expo'ya
      # ait DEĞİL ve faturalama için güncel kalmalı.
      - dependency-name: 'expo'
      - dependency-name: 'expo-*'
      - dependency-name: '@expo/*'
      - dependency-name: 'eslint-config-expo'
      - dependency-name: 'react'
      - dependency-name: 'react-dom'
      - dependency-name: 'react-native'
      - dependency-name: 'react-native-gesture-handler'
      - dependency-name: 'react-native-reanimated'
      - dependency-name: 'react-native-safe-area-context'
      - dependency-name: 'react-native-screens'
      - dependency-name: 'react-native-svg'
      - dependency-name: 'react-native-web'
      - dependency-name: 'react-native-worklets'

      # ── REKLAM SDK'SI — SÜRÜM SABİT, DEPENDABOT DOKUNMAMALI ─────────────
      # `react-native-google-mobile-ads` 16.1+ sürümleri
      # `play-services-ads` 25.x'i çekiyor ve o SDK **Kotlin 2.3.0** ile
      # derlenmiş. Expo SDK 54'ün Kotlin derleyicisi 2.1.0 ve daha yeni
      # metadata'yı OKUYAMIYOR:
      #   "Module was compiled with an incompatible version of Kotlin.
      #    The binary version of its metadata is 2.3.0, expected 2.1.0"
      # Sonuç: AAB derlemesi düşer (üretimde tam olarak bu yaşandı, sürüm
      # 1.6.0'ın ilk Android derlemesi bu yüzden kırıldı).
      #
      # 16.0.0 -> play-services-ads 24.6.0 ile geliyor ve Kotlin 2.1 ile
      # uyumlu. `package.json`'da AÇIKÇA sabit sürüm yazılı (caret YOK) —
      # ikisi birlikte durmalı.
      #
      # Expo SDK yükseltilip Kotlin 2.3+'a geçildiğinde bu satır kaldırılıp
      # paket güncellenebilir.
      - dependency-name: 'react-native-google-mobile-ads'

  - package-ecosystem: npm
    directory: /cheep-backend-express
    schedule: { interval: monthly }
    open-pull-requests-limit: 3
    groups:
      backend-kucuk-guncellemeler:
        patterns: ['*']
        update-types: [minor, patch]
    ignore:
      - dependency-name: '*'
        update-types: [version-update:semver-major]

  - package-ecosystem: npm
    directory: /cheep-website
    schedule: { interval: monthly }
    open-pull-requests-limit: 3
    groups:
      website-kucuk-guncellemeler:
        patterns: ['*']
        update-types: [minor, patch]
    ignore:
      - dependency-name: '*'
        update-types: [version-update:semver-major]

  - package-ecosystem: pip
    directory: /Cheep-Scraper
    schedule: { interval: monthly }
    open-pull-requests-limit: 3
    groups:
      scraper-kucuk-guncellemeler:
        patterns: ['*']
        update-types: [minor, patch]

  # GitHub Actions'ın kendisi. Eylemler ele geçirilebilir bir tedarik zinciri
  # halkası; güncel kalmaları önemli. Az sayıda olduğu için gruplanmıyor.
  - package-ecosystem: github-actions
    directory: /
    schedule: { interval: monthly }
    open-pull-requests-limit: 3
