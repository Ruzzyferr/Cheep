# ============================================
# Cheep — Production ortam değişkenleri (DigitalOcean droplet)
# Bu dosyayı sunucuda `deploy/.env` olarak kopyalayıp doldurun. `.env` ASLA commit edilmez.
# ============================================

# --- Postgres (compose container) ---
POSTGRES_USER=cheep
POSTGRES_PASSWORD=DEGISTIR_guclu_bir_db_parolasi
POSTGRES_DB=cheep_db

# --- Backend ---
NODE_ENV=production
PORT=3000

# DATABASE_URL, yukarıdaki POSTGRES_* ile BİREBİR aynı olmalı. Host = `db` (compose servisi).
DATABASE_URL=postgresql://cheep:DEGISTIR_guclu_bir_db_parolasi@db:5432/cheep_db?schema=public

# --- Kimlik doğrulama (min 32 karakter, BİRBİRİNDEN FARKLI) ---
JWT_SECRET=DEGISTIR_en_az_32_karakter_rastgele_access_secret
JWT_REFRESH_SECRET=DEGISTIR_en_az_32_karakter_FARKLI_refresh_secret

# --- CORS (Expo Go dev için droplet IP'si; domain alınca https origin ekleyin) ---
ALLOWED_ORIGINS=http://localhost:8081

# --- Ingestion (scraper -> backend) ---
INGEST_API_KEY=DEGISTIR_scraper_paylasilan_anahtar

# --- E-posta (kayıt doğrulama) ---
# DigitalOcean giden SMTP'yi (465/587) bloklar → Resend HTTP API (443) kullanın.
RESEND_API_KEY=re_xxx
EMAIL_FROM=info@swiip.app

# --- E-posta (SMTP — yerel/dev alternatifi; DO'da çalışmaz) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@swiip.app
SMTP_PASSWORD=GMAIL_UYGULAMA_SIFRESI
SMTP_FROM_EMAIL=info@swiip.app
SMTP_FROM_NAME=Cheep

# --- AI Asistan (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

DEFAULT_COUNTRY_CODE=TR
