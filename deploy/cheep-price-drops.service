[Unit]
Description=Cheep fiyat düşüşü tespiti (aktif listelerdeki ürünler)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Backend portu host'a açık değil (compose'da yalnızca `expose`), bu yüzden
# istek konteynerin içinden atılıyor — ayrıntı run-price-drops.sh içinde.
ExecStart=/bin/bash /opt/cheep/deploy/run-price-drops.sh
Nice=10
IOSchedulingClass=idle
StandardOutput=append:/var/log/cheep-price-drops.log
StandardError=append:/var/log/cheep-price-drops.log
