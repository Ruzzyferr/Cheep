[Unit]
Description=Cheep Postgres günlük yedeği
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/cheep/deploy/backup-db.sh
Nice=10
IOSchedulingClass=idle
StandardOutput=append:/opt/cheep/backups/backup.log
StandardError=append:/opt/cheep/backups/backup.log
