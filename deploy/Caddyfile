# Cheep — edge reverse proxy + otomatik HTTPS (Let's Encrypt)
#   cheep.live       → website container (Vite SPA; /privacy /delete /terms SPA rotaları)
#   api.cheep.live   → backend:3000 (API)
# SSL sertifikaları ilk açılışta otomatik alınır/yenilenir. Alan adları droplet'e
# (129.212.193.203) çözülmeli ve 80/443 açık olmalı.

{
	email denemelerdeyiz14@gmail.com
}

cheep.live {
	# App Review icin statik dosyalar (inceleme videosu). SPA'ya hic ugramadan
	# diskten servis edilir. gzip DISINDA tutuluyor: sikistirilmis bir yanitta
	# Range istekleri calismaz ve oynaticinin ileri sarmasi bozulur.
	@notreview not path /review/*
	encode @notreview gzip

	handle_path /review/* {
		root * /srv/review
		file_server
	}

	# Güvenlik başlıkları — apex'te HİÇ YOKTU.
	#
	# Backend'de helmet var ama o yalnızca api.cheep.live'ı kapsıyor; bir alt
	# alan adındaki HSTS apex'i korumaz. Oysa apex, Play'in zorunlu tuttuğu
	# HESAP SİLME formunu (/delete) ve yasal metinleri sunuyor. Çerçeve
	# koruması olmadan bir kimlik avı sayfası /delete'i iframe'e alıp
	# kullanıcıya tıklattırabilir (clickjacking) — sonucu geri dönüşsüz.
	header {
		# İki katman: eski tarayıcılar X-Frame-Options, güncel olanlar CSP.
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		# MIME tipi tahmini kapalı (yüklenen içeriğin script gibi çalışması).
		X-Content-Type-Options "nosniff"
		# Yalnızca HTTPS. preload BİLEREK yok: geri alınması aylar sürüyor.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Dış sitelere tam URL sızdırma (SEO sayfaları arama sorgusu taşıyabilir).
		Referrer-Policy "strict-origin-when-cross-origin"
		# Sunucu parmak izini azalt.
		-Server
	}

	handle {
		reverse_proxy website:80
	}

	# Erişim logu. Bu ana kadar HİÇ açık değildi ve "Googlebot siteyi tarıyor
	# mu?" sorusuna bakacak veri yoktu — 7.800 SEO sayfası yayına girerken bu
	# körlük kabul edilemez. Caddy kendi rotasyonunu yapıyor (harici logrotate
	# gerekmiyor); üç dosya × 10 MB ile disk sınırlı.
	log {
		output file /var/log/caddy/cheep.live.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 720h
		}
		format json
	}
}

api.cheep.live {
	encode gzip

	log {
		output file /var/log/caddy/api.cheep.live.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 720h
		}
		format json
	}
	reverse_proxy backend:3000 {
		# XFF'i istemcinin gönderdiğine EKLEME, gerçek uzak adresle DEĞİŞTİR.
		# Backend `trust proxy=1` ile son atlamayı istemci sayıyor; bu satır
		# olmadan istemci başa sahte adres yazıp rate limit kovasını
		# değiştirebilirdi. (src/config/trust-proxy.ts)
		header_up X-Forwarded-For {remote_host}

		# Deploy sırasında backend container'ı ~birkaç saniye yeniden başlıyor.
		# Varsayılan davranışta bu süre boyunca kullanıcı 502 görüyordu. Caddy
		# yalnızca BAĞLANTI kurulamadığında yeniden dener (istek uygulamaya hiç
		# ulaşmamıştır), o yüzden POST'ları tekrarlamak güvenli.
		lb_try_duration 15s
		lb_try_interval 500ms
	}
}
