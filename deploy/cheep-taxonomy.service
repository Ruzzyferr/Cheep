[Unit]
Description=Cheep taksonomi tazeleme (devlet ağacını ham veriden yeniden türetir)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/cheep/deploy/refresh-taxonomy.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3600
StandardOutput=append:/var/log/cheep-taxonomy.log
StandardError=append:/var/log/cheep-taxonomy.log
