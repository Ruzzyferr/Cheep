[Unit]
Description=Cheep şube tazeleme zamanlayıcısı (ayın 1'i, 05:00)

[Timer]
# Ayın 1'i 05:00 UTC — gecelik scrape (01:30-03:30) ve site build (04:00)
# bittikten SONRA. Uzun sürdüğü için sabaha taşması sorun değil; fiyat
# hattıyla çakışmaması önemli.
OnCalendar=*-*-01 05:00:00
Persistent=true
RandomizedDelaySec=1800

[Install]
WantedBy=timers.target
