# Cheep Mobile — Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayın. EXPO_PUBLIC_* değişkenleri Expo tarafından
# build/runtime'da otomatik olarak koda gömülür.

# Backend API kök adresi.
#  - iOS simülatör:        http://localhost:3000/api/v1
#  - Android emülatör:     http://10.0.2.2:3000/api/v1
#  - Fiziksel cihaz:       http://<bilgisayarinizin-LAN-IP>:3000/api/v1
#  - Production (CANLI):   https://api.cheep.live/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
