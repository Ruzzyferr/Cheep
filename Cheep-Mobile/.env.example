# Cheep Mobile — Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayın. EXPO_PUBLIC_* değişkenleri Expo tarafından
# build/runtime'da otomatik olarak koda gömülür.

# Backend API kök adresi.
#  - iOS simülatör:        http://localhost:3000/api/v1
#  - Android emülatör:     http://10.0.2.2:3000/api/v1
#  - Fiziksel cihaz:       http://<bilgisayarinizin-LAN-IP>:3000/api/v1
#  - Production (CANLI):   https://api.cheep.live/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ── AdMob banner reklam birimleri ─────────────────────────────────────────
# ZORUNLU DEĞİL. Tanımsız bırakılırsa uygulama Google'ın TEST birimine düşer:
# reklam görünür, çalışır, ama GELİR ÜRETMEZ.
#
# Geliştirmede burayı GERÇEK kimliklerle doldurmayın — kendi reklamınızı
# yükleyip tıklamak Google'ın "geçersiz trafik" kuralına girer ve AdMob
# hesabının askıya alınmasına yol açar. Gerçek kimlikler yalnızca CI'da
# (GitHub repo değişkenleri) tanımlı olmalı.
#
# Kurulum adımları: docs/ADMOB-SETUP.md
EXPO_PUBLIC_ADMOB_BANNER_HOME=
EXPO_PUBLIC_ADMOB_BANNER_SEARCH=
EXPO_PUBLIC_ADMOB_BANNER_LIST=
