{
  "expo": {
    "name": "Cheep",
    "slug": "cheep-mobile",
    "version": "1.6.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F6F4A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cheep.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#1F6F4A"
      },
      "package": "com.cheep.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cheep uses your location only to show the supermarket branches nearest to you and their real walking distance, for example “Migros, 400 m away”. Your location is never shared with retailers and is never used for advertising. The app works fully without it — you can pick your city manually.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Yansimayla calisan siniflar R8 tarafindan yeniden adlandirilmamali.\n# Cogu kutuphane kendi consumer-rules.pro dosyasini gonderiyor; buradakiler\n# gecmiste R8 ile sorun cikardigi bilinen ve derlemede sessizce kaybolabilecek\n# yuzeyler icin ek guvence.\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.revenuecat.purchases.** { *; }\n-keep class com.android.billingclient.** { *; }\n-keep class expo.modules.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n# Uyarilari hataya cevirme: kullanilmayan optional baglantilar derlemeyi durdurmasin.\n-dontwarn okhttp3.**\n-dontwarn okio.**\n-dontwarn javax.annotation.**"
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#1F6F4A",
          "defaultChannel": "price-drops"
        }
      ],
      "./plugins/withIosOnlyLocales",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2953141598487358~3738075155",
          "iosAppId": "ca-app-pub-2953141598487358~6068725024",
          "delayAppMeasurementInit": true,
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2c82d524-84f5-4b14-8102-862332f5d492"
      },
      "revenuecat": {
        "iosApiKey": "appl_eAziFzgZDsSdvtlmGEMNvSrsOId",
        "androidApiKey": "goog_NietcrEjKGVgBvHoLCyeFjjYRAH"
      }
    },
    "owner": "ruzzyferr",
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json",
      "pl": "./locales/pl.json"
    }
  }
}
