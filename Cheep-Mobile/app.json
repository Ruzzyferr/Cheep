{
  "expo": {
    "name": "Cheep",
    "slug": "cheep-mobile",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F6F4A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cheep.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 16,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#1F6F4A"
      },
      "package": "com.cheep.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cheep uses your location only to show the supermarket branches nearest to you and their real walking distance, for example “Migros, 400 m away”. Your location is never shared with retailers and is never used for advertising. The app works fully without it — you can pick your city manually.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#1F6F4A",
          "defaultChannel": "price-drops"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2c82d524-84f5-4b14-8102-862332f5d492"
      },
      "revenuecat": {
        "iosApiKey": "appl_eAziFzgZDsSdvtlmGEMNvSrsOId",
        "androidApiKey": "goog_NietcrEjKGVgBvHoLCyeFjjYRAH"
      }
    },
    "owner": "ruzzyferr",
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json",
      "pl": "./locales/pl.json"
    }
  }
}
